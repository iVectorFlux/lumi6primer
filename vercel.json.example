{
  "$comment": "Example only — Lumi6 Primer should run on ECS, not Vercel. Use this if you later proxy a static site to an ECS backend.",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_ECS_URL/api/$1"
    },
    {
      "source": "/widget-renderer.js",
      "destination": "https://YOUR_ECS_URL/widget-renderer.js"
    },
    {
      "source": "/widget-host.html",
      "destination": "https://YOUR_ECS_URL/widget-host.html"
    }
  ]
}
